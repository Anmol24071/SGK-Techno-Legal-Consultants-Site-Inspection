# ==================================================
# PRODUCTION & LOCAL ENVIRONMENT VARIABLES TEMPLATE
# SGK Techno-Legal Consultants Site Inspection Portal
# ==================================================

# NextAuth Configuration
NEXTAUTH_URL="https://your-production-app.vercel.app"
NEXTAUTH_SECRET="your_generate_random_secret_32_chars_minimum"

# Administrator Email (Source of Truth for Admin Access)
ADMIN_EMAIL="admin@yourdomain.com"

# PostgreSQL Database Connection (Neon / AWS RDS / Supabase)
DATABASE_URL="postgresql://username:password@ep-sample-host.region.aws.neon.tech/neondb?sslmode=require"

# Google Cloud OAuth Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Google Maps Platform Server API Key (Used for nearby POI search in server-side API)
GOOGLE_MAPS_SERVER_API_KEY="your_google_maps_server_api_key"

# Transactional Email / SMTP Configuration
EMAIL_FROM="SGK Techno-Legal Consultants <noreply@yourdomain.com>"
EMAIL_SERVICE_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your_smtp_app_password"
