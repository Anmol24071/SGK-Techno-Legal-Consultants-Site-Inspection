{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/employee/inspection/*/report",
        "destination": "/employee/inspection/demo/report.html"
      },
      {
        "source": "/employee/inspection/*",
        "destination": "/employee/inspection/demo.html"
      }
    ]
  }
}
